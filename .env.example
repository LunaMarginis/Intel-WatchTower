# abuse.ch Auth-Key (free: https://auth.abuse.ch/). Needed by the ThreatFox and URLhaus exports.
# The code reads the environment variable ABUSECH_AUTH_KEY (it does not load this file itself), e.g. in PowerShell:
#   $env:ABUSECH_AUTH_KEY = "your_abuse_ch_auth_key_here"
ABUSECH_AUTH_KEY=your_abuse_ch_auth_key_here
